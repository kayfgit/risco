<?xml version="1.0" encoding="utf-8"?>
<com.kayf.dedo.HomeRoot xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="76dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:typeface="monospace" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="#D0FFFFFF"
            android:textSize="15sp"
            android:typeface="monospace" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:text="@string/hint"
            android:textColor="#D0FFFFFF"
            android:textSize="14sp"
            android:typeface="monospace" />

        <LinearLayout
            android:id="@+id/pins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D0000000"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/scroller"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="vertical" />
        </ScrollView>

        <EditText
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@null"
            android:gravity="center"
            android:hint="@string/search_hint"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="text|textNoSuggestions|textVisiblePassword"
            android:paddingHorizontal="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="18sp"
            android:typeface="monospace" />
    </LinearLayout>

    <com.kayf.dedo.RailView
        android:id="@+id/rail"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/anchor"
        android:layout_width="1dp"
        android:layout_height="1dp" />
</com.kayf.dedo.HomeRoot>
